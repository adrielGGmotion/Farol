<carbon.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="15dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp"
    app:carbon_maxWidth="500dp">

    <TextView
        android:id="@+id/title_landscape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple"
        android:fontFamily="@font/dm_sans_medium"
        android:minHeight="56dp"
        android:letterSpacing="-0.03"
        android:padding="10dp"
        android:text="@string/settings"
        android:textColor="?attr/colorOnSurface"
        android:textSize="30sp" />

    <include layout="@layout/settings_start_screen" />

    <LinearLayout
        android:id="@+id/group_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:divider="@drawable/grouped_settings_divider"
        android:orientation="vertical"
        android:showDividers="middle">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            app:drawableStartCompat="@drawable/ic_home"
            android:drawablePadding="10dp"
            android:fontFamily="@font/dm_sans_medium"
            android:letterSpacing="-0.03"
            android:padding="15dp"
            android:text="@string/home"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            app:drawableStartCompat="@drawable/ic_pages"
            android:drawablePadding="10dp"
            android:fontFamily="@font/dm_sans_medium"
            android:letterSpacing="-0.03"
            android:padding="15dp"
            android:text="@string/pages"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="7dp"
            android:paddingEnd="15dp"
            android:paddingBottom="7dp">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_theme" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0px" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:paddingTop="10dp"
                    android:text="@string/theme"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/theme_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_regular"
                    android:paddingBottom="10dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_drawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:divider="@drawable/grouped_settings_divider"
        android:orientation="vertical"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/hidden_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="7dp"
            android:paddingEnd="15dp"
            android:paddingBottom="7dp">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_hidden" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0px" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:paddingTop="10dp"
                    android:text="@string/hide_applications"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/hidden_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_regular"
                    android:paddingBottom="10dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="7dp"
            android:paddingEnd="15dp"
            android:paddingBottom="7dp">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_icons" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0px" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:paddingTop="10dp"
                    android:text="@string/icons"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/pack_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_regular"
                    android:paddingBottom="10dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:divider="@drawable/grouped_settings_divider"
        android:orientation="vertical"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/search_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="7dp"
            android:paddingEnd="15dp"
            android:paddingBottom="7dp">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search_engine" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0px" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:paddingTop="10dp"
                    android:text="@string/search_engine"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/engine_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_regular"
                    android:paddingBottom="10dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="7dp"
            android:paddingEnd="15dp"
            android:paddingBottom="7dp">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search_results" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0px" />

            <LinearLayout
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:paddingTop="10dp"
                    android:text="@string/search_results"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_regular"
                    android:paddingBottom="10dp"
                    android:text="@string/kagi_integration"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="0px" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/search_results"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/search_hidden_apps_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            android:padding="7dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/search_hidden_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:drawableStart="@drawable/ic_search_hidden_apps"
                android:drawablePadding="10dp"
                android:fontFamily="@font/dm_sans_medium"
                android:letterSpacing="-0.03"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/search_hidden_apps"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_general"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:divider="@drawable/grouped_settings_divider"
        android:orientation="vertical"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/low_spec_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingTop="7dp"
            android:paddingEnd="15dp"
            android:paddingBottom="7dp">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_memory" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0px" />

            <LinearLayout
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:text="@string/low_spec"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans_regular"
                    android:text="@string/low_spec_description"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="0px" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/low_spec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/vibrations_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            android:padding="7dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/vibrations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:drawableStart="@drawable/ic_vibrations"
                android:drawablePadding="10dp"
                android:fontFamily="@font/dm_sans_medium"
                android:letterSpacing="-0.03"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/vibrations"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />

        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/restart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            app:drawableStartCompat="@drawable/ic_restart"
            android:drawablePadding="10dp"
            android:fontFamily="@font/dm_sans_medium"
            android:letterSpacing="-0.03"
            android:padding="15dp"
            android:text="@string/restart"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/def_launcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple"
            app:drawableStartCompat="@drawable/ic_launch"
            android:drawablePadding="10dp"
            android:fontFamily="@font/dm_sans_medium"
            android:letterSpacing="-0.03"
            android:padding="15dp"
            android:text="@string/system_launcher"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/group_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <carbon.widget.LinearLayout
            android:id="@+id/about_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryContainer"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            app:carbon_cornerRadius="32dp">

            <com.farol.launcher.activities.settings.FarolBeaconView
                android:id="@+id/about_beacon"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:layout_marginStart="-24dp"
                android:layout_marginEnd="-24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/replay_beacon_light"
                android:focusable="true"
                android:tooltipText="@string/replay_beacon_light" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/dm_sans_medium"
                android:letterSpacing="-0.04"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans_regular"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/dm_sans_medium"
                android:letterSpacing="-0.02"
                android:text="@string/farol_headline"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/dm_sans_regular"
                android:text="@string/farol_description"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="16sp" />
        </carbon.widget.LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/creator_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:contentDescription="@string/farol_creator_profile"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.farol.launcher.activities.settings.CookieAvatarView
                        android:id="@+id/creator_avatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_farol" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans_medium"
                            android:importantForAccessibility="no"
                            android:letterSpacing="-0.04"
                            android:text="@string/farol_creator_name"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans_regular"
                            android:importantForAccessibility="no"
                            android:text="@string/farol_creator_handle"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans_regular"
                            android:importantForAccessibility="no"
                            android:text="@string/farol_creator_role"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:alignItems="center"
                    app:flexWrap="wrap"
                    app:justifyContent="space_between">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/creator_website"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/creator_website_description"
                        android:focusable="true"
                        android:fontFamily="@font/dm_sans_medium"
                        android:gravity="start|center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/creator_website"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:tooltipText="@string/creator_website" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/creator_github"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/creator_github_description"
                            android:padding="12dp"
                            android:src="@drawable/ic_github"
                            android:tooltipText="@string/github" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/creator_telegram"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/creator_telegram_description"
                            android:padding="12dp"
                            android:src="@drawable/ic_telegram"
                            android:tooltipText="@string/telegram" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/creator_instagram"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/creator_instagram_description"
                            android:padding="12dp"
                            android:src="@drawable/ic_instagram"
                            android:tooltipText="@string/instagram" />
                    </LinearLayout>
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:divider="@drawable/grouped_settings_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/github"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/about_footer_top"
                app:drawableStartCompat="@drawable/ic_github"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:fontFamily="@font/dm_sans_medium"
                android:minHeight="52dp"
                android:padding="14dp"
                android:text="@string/farol_source"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/app_info_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/grouped_category_middle"
                app:drawableStartCompat="@drawable/ic_about"
                android:drawablePadding="14dp"
                android:focusable="true"
                android:fontFamily="@font/dm_sans_medium"
                android:minHeight="52dp"
                android:padding="14dp"
                android:text="@string/app_info"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/licenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/about_footer_bottom"
                app:drawableStartCompat="@drawable/ic_license"
                android:drawablePadding="14dp"
